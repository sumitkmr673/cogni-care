# Copy to voice_service/.env to override defaults. run.ps1 reads JWT_SECRET_KEY and JWT_ALGORITHM
# from ../backend/.env first, so tokens from the main backend are accepted here.

# 127.0.0.1 is enough for the emulator (10.0.2.2 on the device). Use 0.0.0.0 for a real phone on Wi-Fi.
VOICE_HOST=127.0.0.1
VOICE_PORT=8100

# Qwen, served by llama-server (started by run.ps1 on 127.0.0.1:8101, every layer on the GPU).
VOICE_LLM_PATH=../Models/Qwen3-8B-Q4_K_M.gguf
VOICE_LLM_CONTEXT=2048

VOICE_WHISPER_MODEL=medium
VOICE_WHISPER_DEVICE=cuda
# int8_float16 keeps Whisper near 1 GB of VRAM so Qwen3-8B fits beside it on an 8 GB card.
# Use int8 with VOICE_WHISPER_DEVICE=cpu if there is no NVIDIA card.
VOICE_WHISPER_COMPUTE_TYPE=int8_float16

# A spoken answer is a few seconds; this caps an upload at 5 MB.
VOICE_MAX_AUDIO_BYTES=5242880